# neon console > project > connect, pooled connection string
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# random 32+ byte secret that signs sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# the app's own origin, vercel previews fall back to VERCEL_BRANCH_URL when unset
BETTER_AUTH_URL=http://localhost:3000

# google cloud console > google auth platform > clients > web client
# redirect uri: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
